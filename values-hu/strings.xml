    <!-- Telemetry consent -->
    <string name="telemetry_consent_title">Adatmegosztás</string>
    <string name="telemetry_consent_first_use_body">Az Inware használati elemzéseket és összeomlási jelentéseket oszthat meg az alkalmazás fejlesztése érdekében. Semmi sem kerül megosztásra, hacsak nem választja azt, és ezt bármikor módosíthatja a Beállításokban.</string>
    <string name="telemetry_consent_upgrade_body">A 7.1.0-s verziótól kezdve az Inware lehetővé teszi a használati elemzések és az összeomlási jelentések külön történő kezelését. Semmi sem kerül megosztásra, hacsak nem választja azt, és ezt bármikor módosíthatja a Beállításokban.</string>
    <string name="telemetry_consent_first_use_policy_message">Részletekért olvassa el az [Adatvédelmi irányelveket](<xliff:g id="link" example="https://example.com">%1$s</xliff:g>).</string>
